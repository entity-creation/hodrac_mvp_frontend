VITE_DEV_BACKEND_ROOT_URL=************************************
DEV_BACKEND_ROOT_URL=*****************************************
VITE_EMAILJS_SERVICE_ID=**************************************
VITE_EMAILJS_TEMPLATE_ID=*************************************
VITE_API_BASE_URL=********************************************
VITE_EMAILJS_PUBLIC_KEY=**************************************
# Hodrac Host (paid hosted trips): true on staging, false in production until launch
VITE_HOST_ENABLED=false

# Test/staging: put VITE_API_BASE_URL=<your test backend> (and VITE_HOST_ENABLED=true)
# in .env.staging, then run `npm run dev:staging` or `npm run build:staging`.
# `npm run dev` also reads .env.development.local (e.g. your local backend).
